# Contoh konfigurasi environment MISI GEOMETRI.
# Salin menjadi .env ATAU pasang sebagai Environment= di file systemd.
# Jangan commit file .env asli!

# Port aplikasi (diakses nginx via reverse proxy)
PORT=3021

# Folder data (database SQLite). Pisahkan dari folder kode agar aman saat git pull.
DATA_DIR=/var/lib/gezymuse-quiz

# Rate limit submit: maks percobaan per IP per jendela waktu (menit)
SUBMIT_MAX=30
SUBMIT_WINDOW_MIN=1
